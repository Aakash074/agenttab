# Copy to .env.local (gitignored) and fill in. All optional.
# BCH BLAZE banner
VITE_DECK_URL=https://docs.google.com/presentation/d/<your-widget-factory-copy>
VITE_REPO_URL=https://github.com/<you>/agenttab
VITE_DONATION_ZADDR=bitcoincash:z<your-token-aware-address>
VITE_PROTOTYPE_URL=https://github.com/<you>/agenttab-prototype
# Demo agent pubkey (DEMO_AGENT_PUB from `node packages/covenant/scripts/pubkeys.ts`); also read from the server's /.well-known
VITE_DEMO_AGENT_PUB=
# API servers per network ('' = same origin / Vite proxy). Setting the mainnet URL enables Mainnet in the selector.
VITE_SERVER_URL_CHIPNET=
VITE_SERVER_URL_MAINNET=
